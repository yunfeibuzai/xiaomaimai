#!/bin/bash
# ==========================================
# Minecraft 分布式模块化运维助手 4.0 (纯净无后缀版)
# 主入口文件: scripts/mc
# ==========================================

# 1. 全局配置 (通过 export 共享给所有子模块)
export CONTAINER_NAME="mcserver"
export SCRIPT_URL="https://raw.githubusercontent.com/yunfeibuzai/xiaomaimai/main/scripts/mc"
export MODULE_BASE="https://raw.githubusercontent.com/yunfeibuzai/xiaomaimai/main/scripts/modules"

# 2. 全局颜色定义
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[0;33m'
export BLUE='\033[0;34m'
export CYAN='\033[0;36m'
export NC='\033[0m'

# 3. 动态状态检测
function check_status() {
    if [ "$(docker ps -q -f name=$CONTAINER_NAME)" ]; then
        STATUS="${GREEN}[运行中 / Online]${NC}"
    elif [ "$(docker ps -aq -f name=$CONTAINER_NAME)" ]; then
        STATUS="${RED}[已停止 / Offline]${NC}"
    else
        STATUS="${YELLOW}[未创建 / Not Found]${NC}"
    fi
}

# 4. 显示菜单
function show_menu() {
    clear
    check_status
    echo -e "${CYAN}=======================================${NC}"
    echo -e "${GREEN}    🧊 Minecraft 模块化运维助手 4.0${NC}"
    echo -e "${CYAN}=======================================${NC}"
    echo -e " 🖥️  服务器状态: ${STATUS}"
    echo -e " 🏷️  容器名称  : ${YELLOW}${CONTAINER_NAME}${NC}"
    echo -e "${CYAN}---------------------------------------${NC}"
    echo -e "${BLUE}▶ 基础控制 (Control)${NC}"
    echo -e "  ${GREEN}1.${NC} 🟢 启动服务器"
    echo -e "  ${RED}2.${NC} 🔴 停止服务器"
    echo -e "  ${YELLOW}3.${NC} 🔄 重启服务器"
    echo -e "${BLUE}▶ 监控与管理 (Monitor & Manage)${NC}"
    echo -e "  ${CYAN}4.${NC} 📜 查看实时日志 (Ctrl+C 返回)"
    echo -e "  ${CYAN}5.${NC} 📊 查看性能占用 (CPU/内存)"
    echo -e "  ${CYAN}6.${NC} ⌨️  发送单条指令 (如: op, whitelist)"
    echo -e "  ${CYAN}7.${NC} 💬 进入交互控制台 (连续输入模式)"
    echo -e "${BLUE}▶ 数据与模组 (Data & Mods)${NC}"
    echo -e "  ${YELLOW}8.${NC} 📦 一键完整备份 (世界存档)"
    echo -e "  ${YELLOW}9.${NC} 🧩 查看已安装模组 (Mods列表)"
    echo -e "  ${YELLOW}10.${NC}📥 交互式添加模组 (在线下载)"
    echo -e "${BLUE}▶ 系统功能 (System)${NC}"
    echo -e "  ${CYAN}11.${NC}🚀 从 GitHub 更新主控菜单脚本"
    echo -e "${CYAN}---------------------------------------${NC}"
    echo -e "  ${RED}0.${NC} ❌ 退出面板"
    echo -e "${CYAN}=======================================${NC}"
}

# 5. 核心路由器 (拉取 GitHub 上的无后缀子脚本)
function run_module() {
    local mod_name=$1
    curl -sSL "${MODULE_BASE}/${mod_name}" -o "/tmp/mc_mod_${mod_name}"
    chmod +x "/tmp/mc_mod_${mod_name}"
    "/tmp/mc_mod_${mod_name}"
}

# 6. 自我更新功能
function update_script() {
    echo -e "${YELLOW}⏳ 正在从 GitHub 获取最新主控脚本...${NC}"
    if curl -sSL "$SCRIPT_URL" -o /usr/local/bin/mc; then
        chmod +x /usr/local/bin/mc
        echo -e "${GREEN}✅ 主控菜单更新成功！${NC}"
        sleep 1
        exec /usr/local/bin/mc
    else
        echo -e "${RED}⚠️ 更新失败！请检查网络或 GitHub 仓库地址。${NC}"
    fi
}

# 7. 循环监听
while true; do
    show_menu
    read -p "🎯 请输入序号执行操作: " num
    case $num in
        1) run_module "start" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        2) run_module "stop" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        3) run_module "restart" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        4) run_module "logs" ;; 
        5) run_module "stats" ;; 
        6) run_module "command" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        7) run_module "console" ;;
        8) run_module "backup" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        9) run_module "list_mods" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        10) run_module "add_mod" ; read -n 1 -s -r -p "按任意键返回菜单..." ;;
        11) update_script ;;
        0) echo -e "${GREEN}👋 拜拜！${NC}" ; exit 0 ;;
        *) echo -e "${RED}⚠️ 无效输入!${NC}" ; sleep 1 ;;
    esac
done
